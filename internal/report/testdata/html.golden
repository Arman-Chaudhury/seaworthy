<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>seaworthy report</title>
<style>
  :root { --high:#c62828; --medium:#ef6c00; --low:#1565c0; --ink:#1c2733; --paper:#f6f8fa; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 -apple-system,"Segoe UI",Roboto,sans-serif; color:var(--ink); background:var(--paper); }
  header { padding:1.2rem 1.5rem; background:#0b2e4f; color:#fff; }
  header h1 { margin:0; font-size:1.25rem; }
  main { padding:1.5rem; max-width:70rem; margin:0 auto; }
  .tiles { display:flex; gap:.8rem; flex-wrap:wrap; margin-bottom:1.2rem; }
  .tile { flex:1 1 8rem; background:#fff; border-radius:.5rem; padding:.8rem 1rem; border:1px solid #dde3ea; }
  .tile b { display:block; font-size:1.6rem; }
  .tile.high b { color:var(--high); } .tile.medium b { color:var(--medium); } .tile.low b { color:var(--low); }
  .delta { margin:0 0 1.2rem; padding:.7rem 1rem; background:#fff; border:1px solid #dde3ea; border-radius:.5rem; }
  input#q { width:100%; padding:.55rem .8rem; margin-bottom:.8rem; border:1px solid #c8d1db; border-radius:.4rem; font-size:1rem; }
  .tablewrap { overflow-x:auto; background:#fff; border:1px solid #dde3ea; border-radius:.5rem; }
  table { border-collapse:collapse; width:100%; min-width:52rem; }
  th, td { text-align:left; padding:.5rem .8rem; border-top:1px solid #eef1f5; vertical-align:top; }
  th { background:#f0f3f7; border-top:none; font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; }
  .sev { font-weight:700; text-transform:uppercase; font-size:.78rem; }
  .sev.high { color:var(--high); } .sev.medium { color:var(--medium); } .sev.low { color:var(--low); }
  td.rule { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.85rem; white-space:nowrap; }
  td.loc { color:#5c6b7a; font-size:.82rem; }
  .hint { color:#5c6b7a; font-size:.85rem; }
  footer { padding:1rem 1.5rem; color:#5c6b7a; font-size:.82rem; }
</style>
</head>
<body>
<header><h1>seaworthy — workload hygiene report</h1></header>
<main>
  <div class="tiles">
    <div class="tile"><b>3</b>findings</div>
    <div class="tile high"><b>1</b>high</div>
    <div class="tile medium"><b>1</b>medium</div>
    <div class="tile low"><b>1</b>low</div>
    <div class="tile"><b>1</b>baseline-suppressed</div>
  </div>
  <p class="delta">vs previous run: <b>1</b> new, <b>0</b> fixed</p>
  <input id="q" type="search" placeholder="filter findings (rule, object, message…)" oninput="flt()">
  <div class="tablewrap"><table id="t">
    <thead><tr><th>Severity</th><th>Rule</th><th>Object</th><th>Message</th><th>Location</th></tr></thead>
    <tbody>
    <tr>
      <td><span class="sev low">low</span></td>
      <td class="rule">missing-labels</td>
      <td>shop/Deployment/api</td>
      <td>missing label(s) app.kubernetes.io/name<div class="hint">add the recommended labels</div></td>
      <td class="loc"></td>
    </tr><tr>
      <td><span class="sev high">high</span></td>
      <td class="rule">latest-image</td>
      <td>shop/Deployment/web</td>
      <td>container &#34;web&#34;: image &#34;nginx:latest&#34; is not pinned<div class="hint">pin a version tag or digest so rollouts and rollbacks are reproducible</div></td>
      <td class="loc">deploy/web.yaml:4</td>
    </tr><tr>
      <td><span class="sev medium">medium</span></td>
      <td class="rule">no-pdb</td>
      <td>shop/Deployment/web</td>
      <td>3 replicas but no PodDisruptionBudget matches its pods<div class="hint">add a PDB so voluntary disruptions cannot take every replica down at once</div></td>
      <td class="loc">deploy/web.yaml:4</td>
    </tr>
    </tbody>
  </table></div>
</main>
<footer>generated by seaworthy — findings only, no manifest contents are embedded</footer>
<script>
function flt(){
  var q=document.getElementById('q').value.toLowerCase();
  var rows=document.querySelectorAll('#t tbody tr');
  for(var i=0;i<rows.length;i++){
    rows[i].style.display=rows[i].textContent.toLowerCase().indexOf(q)>=0?'':'none';
  }
}
</script>
</body>
</html>
